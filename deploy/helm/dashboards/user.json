{
  "id": null,
  "title": "VeloCore - Deployment Dashboard",
  "uid": "velocore-user-dashboard-1",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Deployment Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Failed"
                },
                "1": {
                  "color": "green",
                  "text": "Running"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "velocore_deployment_status{deployment=\"$deployment\"}",
          "refId": "A",
          "legendFormat": "Status"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "cfu6k2vm87gn4c"
      },
      "description": "Current deployment status"
    },
