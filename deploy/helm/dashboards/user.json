          "legendFormat": "Deployments"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Deployment history and status",
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        }
      ]
    },
