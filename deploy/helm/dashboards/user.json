              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "green",
                "value": 604800
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "velocore_deployment_uptime_seconds",
          "refId": "A",
          "legendFormat": "Uptime"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Total deployment uptime"
