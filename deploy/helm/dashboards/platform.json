{
  "title": "VeloCore - Platform Dashboard",
  "uid": "velocore-platform",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Running Deployments",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "velocore_running_deployments",
          "refId": "A",
          "legendFormat": "Running"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "bftwe85msrpxcd"
      },
      "description": "Currently running deployments"
    },
